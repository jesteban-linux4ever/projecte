from machine import Pin
from time import sleep
import dht
sensor = dht.DHT22(Pin(17))
led = Pin(2, Pin.OUT)
T_ALT, T_BAIX = 30.0, 28.0
alarma = False
while True:
    try:
        sensor.measure()
        t, h = sensor.temperature(), sensor.humidity()
        if t > T_ALT:
            alarma = True
        elif t < T_BAIX:
            alarma = False
        led.value(alarma)
        print("T={:.1f}C  H={:.1f}%  Alarma={}".format(t, h, "SI" if alarma else "NO"))
    except OSError:
        print("Error de lectura")
    sleep(2)
