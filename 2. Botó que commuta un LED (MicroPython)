from machine import Pin
import time
led = Pin(2, Pin.OUT)
btn = Pin(4, Pin.IN, Pin.PULL_UP)
mode = 0            # 0=apagat, 1=encès, 2=intermitent
last = 1
blink_state = 0
t_last = time.ticks_ms()
while True:
    cur = btn.value()
    if last == 1 and cur == 0:
        mode = (mode + 1) % 3
        print("Mode:", mode)
        time.sleep_ms(20)
    last = cur
    if mode == 0:
        led.value(0)
    elif mode == 1:
        led.value(1)
    elif time.ticks_diff(time.ticks_ms(), t_last) >= 500:
        t_last = time.ticks_ms()
        blink_state ^= 1
        led.value(blink_state)
    time.sleep_ms(10)
